{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/csjhang/agent-session-authority/spec/authority-profile.schema.json",
  "title": "AuthorityProfile",
  "type": "object",
  "properties": {
    "profile_version": {
      "type": "string",
      "description": "Profile schema / vocabulary version (Week-1: \"0.2\")."
    },
    "target": {
      "type": "string",
      "description": "Named target under assessment (synthetic or real)."
    },
    "generation_model": {
      "type": "string",
      "enum": [
        "G0",
        "G1",
        "G2"
      ],
      "description": "Runtime generation model claimed by the target."
    },
    "claimed_invariants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Invariant IDs the target declares (e.g. AUTH-01, AUTH-03b). Drives claim_status; independent of checker result."
    },
    "scope_decision": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Map of \"action_type|target\" \u2192 scope_id."
    },
    "scope_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_type",
          "target",
          "scope_id"
        ],
        "properties": {
          "action_type": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "scope_id": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "description": "Structured scope rows; alternative to scope_decision."
    },
    "known_bypasses": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Documented bypasses / out-of-band paths."
    },
    "coverage_boundary": {
      "type": "string",
      "description": "What the profile does and does not cover."
    },
    "terminal_rules": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "cancel_wins",
          "complete_wins",
          "timeout_wins",
          "restart_wins",
          "failed_wins",
          "reconcile_required"
        ]
      },
      "description": "AUTH-07 published terminal rules; values limited to cancel_wins, complete_wins, timeout_wins, restart_wins, failed_wins, reconcile_required"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
